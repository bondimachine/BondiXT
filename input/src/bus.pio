.program bus

; Pins 0-7: AD0-AD7 (Base+0 to Base+7)
; Pin 8: /RD (Base+8)
; Pin 9: /WR (Base+9)
; Pin 10: /CS (Base+10) (!A8 && !A9 && IO, right after ALE)
; Pin 11: READY

; Packet Format sent to CPU (RX FIFO):
; Both Read and Write cycles now align Address and Flag positions.
; Format: [ Padding/Top | Address | Data/Dummy | Flag ]
; Bits 0:   Is Write (0 = Read, 1 = Write)
; Bits 1-8:  Data (For Write) or 0x00 (For Read)
; Bits 9-16: Address

.wrap_target
    ; 1. Wait for /CS (Active Low)
    wait 0 pin 10

    ; 2. Read Address (AD0-AD7)
    ; ISR: [ ... | Address ]
    in pins, 8
    
    ; 3. Check /RD
    jmp pin check_write

    ; === READ CYCLE ===
    ; /RD is LOW (Active).
    
    ; ISR: [ (Address << 9)], autopush
    in null, 9;
    
    set pindirs, 1; set IOCHREADY as output
    set pins, 0; set IOCHREADY dn

    ; Wait for Data from TX FIFO (from CPU).
    pull block

    ; Drive Data on AD0-AD7
    mov pins, osr

    mov osr, y
    ; Enable Output Driver (Set AD0-AD7 to Output)
    out pindirs, 8
    set pindirs, 0; set IOCHREADY as high impedance

    ; Wait for /RD High (End of Read)
    wait 1 pin 8

    ; Disable Output Driver (Set pins to Input)
    mov osr, null
    out pindirs, 8   

    jmp end_cycle

check_write:
    ; === WRITE CYCLE ===
    ; /RD was High. Wait for /WR Low.
    wait 0 pin 9
    
    ; Read Data (AD0-AD7)
    ; ISR already has Address.
    ; ISR: [ (Address << 8) | Data ]
    in pins, 8

    ; Add Flag: 0x00 for Write
    ; ISR: [ (Address << 9) | (Data << 1) | 0b1 ], autopush
    in y, 1

end_cycle:
    ; Wait for /CS High (De-assertion)
    wait 1 pin 10

.wrap

% c-sdk {
static inline void bus_program_init(PIO pio, uint sm, uint offset, uint base_pin) {
    pio_sm_config c = bus_program_get_default_config(offset);

    // 1. Configure Pin Mappings
    sm_config_set_in_pins(&c, base_pin);
    sm_config_set_out_pins(&c, base_pin, 8);
    sm_config_set_set_pins(&c, base_pin + 11, 1);
    sm_config_set_jmp_pin(&c, base_pin + 8);

    // 2. Configure Shift Directions
    // IN Shift: Left, Autopush ON
    // ISR = (ISR << count) | Input.
    // We shift in: Address(8) -> Data/Dummy(8) -> Flag(1).
    sm_config_set_in_shift(&c, false, true, 17); 

    // OUT Shift: Right, Autopull OFF
    sm_config_set_out_shift(&c, true, false, 32);

    // 3. Initialize GPIOs
    for (uint i = 0; i <= 11; i++) {
        pio_gpio_init(pio, base_pin + i);
    }

    // 4. Set Pin Directions (All Input initially)
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin, 12, false);

    // 5. Pre-load Y register with 0xFFFFFFFF
    pio_sm_exec(pio, sm, pio_encode_mov_not(pio_y, pio_null));

    // 6. Init and Enable
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
