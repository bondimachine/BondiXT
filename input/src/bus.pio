.program bus

; Pins 0-7: D0-D7 
; Pin 8: /CS (!A8 && !A9 && IO && !ALE)
; Pin 14: DT/R 
; Pin 15: A2
; Pin 26: \WR & \RD 

; Packet Format sent to CPU (RX FIFO):
; Both Read and Write cycles now align Address and Flag positions.
; Format: [ Padding/Top | Address | Data/Dummy | Flag ]
; Bits 0:   Is Write (0 = Read, 1 = Write)
; Bits 1-8:  Data (For Write) or 0x00 (For Read)
; Bits 9-16: Address

.wrap_target
restart:
    ; Wait for /CS High (De-assertion)
    wait 1 pin 8

wait_for_something:
    pull noblock; Read any possible update from for output buffer, or returns current value of x
    mov x, osr; save update if any.

    jmp pin wait_for_something; CS is high, need to keep waiting.

    mov osr, pins
    out NULL, 14
    in osr, 1 ; read DT/R
    mov y, isr ; y = DT/R (0 for Read, 1 for Write)


    mov isr, null
    out NULL, 1
    in osr, 1 ; read A2

    ; 3. Check /RD
    jmp y-- write

    ; === READ CYCLE ===
    ; DT/R is LOW (Read).
    mov y, isr ; y = A2
    
    wait 0 pin 9; // Wait for /RD to go low

    pull noblock; Read any possible update from for output buffer, or returns current value of x 
    mov x, osr; save update if any.
    jmp !y read60

    out null, 8 ; status register is on the upper 8 bits, so we shift it right

read60:

    ; Drive Data on AD0-AD7
    mov pins, osr

    ; Enable Output Driver (Set AD0-AD7 to Output)
    mov osr, ~null
    out pindirs, 8
    mov osr, null

    ; Wait for /RD High (End of Read)
    wait 1 pin 26

    ; Disable Output Driver (Set pins to Input)
    out pindirs, 8   
    
    ; ISR: [ (Address << 9)], autopush
    in null, 9;

    jmp restart

write:
    ; === WRITE CYCLE ===
    ; /RD was High. Wait for /WR Low.
    wait 0 pin 26
    
    ; Read Data (AD0-AD7)
    ; ISR already has Address.
    ; ISR: [ (Address << 8) | Data ]
    in pins, 8

    ; Add Flag: 0x00 for Write
    ; ISR: [ (Address << 9) | (Data << 1) | 0b1 ], autopush

    mov y, ~null
    in y, 1

.wrap

% c-sdk {
static inline void bus_program_init(PIO pio, uint sm, uint offset, uint base_pin) {
    pio_sm_config c = bus_program_get_default_config(offset);

    // 1. Configure Pin Mappings
    sm_config_set_in_pins(&c, base_pin);
    sm_config_set_out_pins(&c, base_pin, 8); // D0-D7
    sm_config_set_jmp_pin(&c, base_pin + 8); // CS

    // 2. Configure Shift Directions
    // IN Shift: Left, Autopush ON
    // ISR = (ISR << count) | Input.
    // We shift in: Address(1) -> Data/Dummy(8) -> Flag(1).
    sm_config_set_in_shift(&c, false, true, 10); 

    // OUT Shift: Right, Autopull OFF
    sm_config_set_out_shift(&c, true, false, 32);

    // 3. Initialize GPIOs
    for (uint i = 0; i <= 8; i++) {
        pio_gpio_init(pio, base_pin + i);
    }
    pio_gpio_init(pio, base_pin + 14);
    pio_gpio_init(pio, base_pin + 15);
    pio_gpio_init(pio, base_pin + 26);

    // 4. Set Pin Directions (All Input initially)
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin, 8, false);
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin + 14, 2, false);
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin + 26, 1, false);

    // 6. Init and Enable
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
