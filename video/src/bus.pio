.program bus

; Bus Interface for RP2350
; Implements a write-only interface (ignoring reads for now)
;
; Protocol:
; 1. Wait for !CS
; 2. Wait for CLK up (t1) 
; 3. Read 16-bit Address (D0-D15)
; 4. Wait for CLK dn (t2)
; 5. Wait for CLK up (t2)
; 6. Read A16 from D15
; 7. Read 8-bit Data (D0-D7)
; 8. Push Address and Data to FIFO
; 6. Wait for CS high
;
; Pin Mapping Assumption:
; - IN pins base is mapped to D0
; - CS is 28
; - CLK is 16

.define CLK 16
.define CS 28

    set x, 1           

.wrap_target
    ; 1. Wait for !CS
    wait 0 gpio CS        ; Wait for CS (pin 28 relative to IN base) to be Low
    wait 1 gpio CLK

    in x, 1              ; Flag that we have data

    ; 2. Save D0-D15 in addr register (ISR)
    in pins, 16          ; Shift 17 bits from pins into ISR

    mov osr, isr
    out NULL, 15
    mov x, osr ; x = A15

    ; 3. Wait for t1 to end
    wait 0 gpio CLK

    ; 3. Wait for t2 to be up
    wait 1 gpio CLK

    mov osr, pins
    out NULL, 15         ; Discard 14 bits
    in osr, 1          ; Read A16 from D15

    ; 4. Save D0-D7 to data register (ISR)
    in pins, 8           ; Shift 8 bits from pins into ISR
                         ; ISR now contains [Address (17) << 8| Data (8)]
                         ; Also it is autopushed to RX FIFO


    jmp x-- wait_cs_up ; if A15>0, then it is memory access, otherwise check A16
    mov x, osr ; x = A16
    jmp !x wait_cs_up; if !A16, it is memory in A0000, otherwise it is B0000 which is port access

    ; this is ultra crappy, but given we already saved the value, we can drive the bus
    ; and set the pins to support a potential read in port 0x3da. 

    irq 1

    wait 0 gpio CLK

    wait 1 gpio CLK
    wait 0 gpio CLK

    set pindirs, 0

wait_cs_up:
    wait 1 gpio CS        ; Wait for CS high

.wrap

% c-sdk {
static inline void bus_program_init(PIO pio, uint sm, uint offset, uint base_pin) {
    pio_sm_config c = bus_program_get_default_config(offset);

    // Map the state machine's IN pin group to D0..D16
    sm_config_set_in_pins(&c, base_pin);

    sm_config_set_out_pins(&c, base_pin, 8);

    // Set this pin's GPIO function (connect PIO to the pad)
    // Initialize all 17 pins (D0-D16)
    for (uint i = 0; i < 17; i++) {
        pio_gpio_init(pio, base_pin + i);
    }

    pio_gpio_init(pio, 28);
    
    // Set the pin direction to input at the PIO
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin, 17, false);

    pio_sm_set_consecutive_pindirs(pio, sm, 28, 1, false);

    // Shift in configuration left and auto push with 25 bits
    sm_config_set_in_shift(&c, false, true, 25);

    sm_config_set_out_shift(&c, true, false, 32);
    
    // Join the TX and RX FIFOs into a single 8-word RX FIFO
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    // Load our configuration, and jump to the start of the program
    pio_sm_init(pio, sm, offset, &c);
    
    // Enable the state machine
    pio_sm_set_enabled(pio, sm, true);
}
%}
