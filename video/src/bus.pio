.program bus
;
;
; Bus Interface for RP2350
; Implements a write-only interface (ignoring reads for now)
;
; Protocol:
; 1. Wait for !CS
; 2. Read Address (D0-D14)
; 3. Switch MUX [pin 16]
; 4. Read A15 and A16. Read IO/M and DT/R
; 5. If DT/R is high: (write)
;    ; 6. Wait for !DEN
;    ; 7. Read 8-bit Data (D0-D7)
;    ; 8. Push Address and Data to FIFO
;    ; 9. Switch MUX back 
; 10. Wait for CS high
;
; Pin Mapping Assumption:
; - IN pins base is mapped to D0

.define DEN 15
.define CS 15
.define MUX 16
.define IOCHRDY 28

    set x, 1           

.wrap_target
restart:
    set pins, 0 [10]     ; Set MUX back to select D0-D14. Delays 2 to wait for the change to propagate

    wait 1 gpio CS        ; Wait for CS high
    ; 1. Wait for !CS
    wait 0 gpio CS        ; Wait for CS (pin 28 relative to IN base) to be Low

    in x, 1              ; Flag that we have data

    ; 2. Save D0-D14 in addr register (ISR)
    in pins, 15          ; Shift 15 bits from pins into ISR
    set pins, 1   [10]       ; Set MUX to select A15/A16/IO/M/DT/R . 

    mov osr, pins
    out NULL, 11         ; Discard D0-D10 which are still in the pins
    in osr, 4            ; shift in A15/A16/IO/M/DT/R 

    jmp pin write

    mov osr, x           ; Flag CHORDY
    out pindirs, 1
    mov osr, NULL
    out pins, 1

    in NULL, 8           ; Push the read request.

    ; IOCHRDY will be released by read part, we just wait here until everything is done.
    wait 0 gpio DEN
    wait 1 gpio DEN

    jmp restart

write:
    ; 3. Wait for DEN to be down
    wait 0 gpio DEN


    ; 4. Save D0-D7 to data register (ISR)
    in pins, 8           ; Shift 8 bits from pins into ISR
                         ; ISR now contains [A14-A0 << 12 | DT/R << 11 | IO/R << 10 | A16-A15 << 8 | Data (8)]
                         ; Also it is autopushed to RX FIFO

.wrap

% c-sdk {
static inline void bus_program_init(PIO pio, uint sm, uint offset, uint base_pin) {
    pio_sm_config c = bus_program_get_default_config(offset);

    // Map the state machine's IN pin group to D0..D16
    sm_config_set_in_pins(&c, base_pin);

    sm_config_set_out_pins(&c, 28, 1);

    sm_config_set_jmp_pin(&c, 14);

    sm_config_set_set_pins(&c, 16, 1);

    // Set this pin's GPIO function (connect PIO to the pad)
    // Initialize all 17 pins (D0-D16)
    for (uint i = 0; i < 17; i++) {
        pio_gpio_init(pio, base_pin + i);
    }

    pio_gpio_init(pio, 28);
    
    // Set the pin direction to input at the PIO
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin, 16, false);

    pio_sm_set_consecutive_pindirs(pio, sm, 16, 1, true); // MUX pin as output
    pio_sm_set_consecutive_pindirs(pio, sm, 28, 1, false); // IOCHRDY pin as higih impedance 

    // Shift in configuration left and auto push with 27 bits
    sm_config_set_in_shift(&c, false, true, 27);

    sm_config_set_out_shift(&c, true, false, 32);
    
    // Join the TX and RX FIFOs into a single 8-word RX FIFO
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    // Load our configuration, and jump to the start of the program
    pio_sm_init(pio, sm, offset, &c);
    
    // Enable the state machine
    pio_sm_set_enabled(pio, sm, true);
}
%}
