.program bus_read
;
;
; Bus Interface for RP2350
; Read side
;
; Protocol:
; 1. Wait for TX FIFO to have data (indicating a read request)
; 2. Set pins as output (D0-D7) and output the data from the FIFO
; 3. Set IOCHRDY (pin 28) to read/high impedance to indicate data is ready
; 4. Wait for /RW to be toggled down
; 5. Wait for /RW to be toggled up
; 6. Set pins as input


.define WRRD 15
.define IOCHRDY 28

.wrap_target
    ; 1. Wait for TX FIFO to have data (indicating a read request)
    pull block         ; Pulls 32-bit word from TX FIFO into OSR
    mov y, osr         ; Save data in Y
    
    ; 2. Set pins as output (D0-D7) and output the data from the FIFO
    mov osr, ~NULL     ; Prepare all 1s
    out pindirs, 8     ; Set D0-D7 direction to OUTPUT
    mov osr, y         ; Restore data
    out pins, 8        ; Output data to D0-D7
    
    ; 3. Set IOCHRDY to input (high-Z)
    set pindirs, 0     ; Set pin 28 to input (high-Z)
    
    ; 4. Wait for /RW to be toggled down
    wait 0 gpio WRRD    
    
    ; 5. Wait for /RW to be toggled up
    wait 1 gpio WRRD
    
    ; 6. Set pins as input
    mov osr, NULL      ; Prepare all 0s
    out pindirs, 8     ; Set D0-D7 direction to INPUT (high-Z)
.wrap

% c-sdk {
static inline void bus_read_program_init(PIO pio, uint sm, uint offset, uint base_pin) {
    pio_sm_config c = bus_read_program_get_default_config(offset);

    // Map OUT pins to D0-D7 (for data output and direction)
    sm_config_set_out_pins(&c, base_pin, 8);

    // Map SET pins to IOCHRDY (pin 28)
    sm_config_set_set_pins(&c, 28, 1);

    // Initialize all 8 data pins
    for (uint i = 0; i < 8; i++) {
        pio_gpio_init(pio, base_pin + i);
    }
    pio_gpio_init(pio, 28);
    
    // Set initial pin directions
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin, 8, false); // D0-D7 inputs
    pio_sm_set_consecutive_pindirs(pio, sm, 28, 1, false); // IOCHRDY high impedance

    // Disable auto pull, shift right
    sm_config_set_out_shift(&c, true, false, 32);

    // Load our configuration, and jump to the start of the program
    pio_sm_init(pio, sm, offset, &c);
    
    // Enable the state machine
    pio_sm_set_enabled(pio, sm, true);
}
%}
